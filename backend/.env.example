# LLM Provider Configuration (OpenRouter by default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# A voice turn spends two round trips here and has to answer inside
# Twilio's 15 seconds, so the model's SPEED matters as much as its quality.
# Prefer a slug OpenRouter serves from a fast provider (Groq, Cerebras).
# Whatever you change this to, validate it with scripts/run_recovery_batch.py
# and read the RECOVERED counts, not rule_breaks - see FINDINGS #14 for what
# a bad swap looks like (recoveries 6 -> 0 while check_offer fired MORE).
LLM_MODEL=openai/gpt-4o-mini

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Security & HMAC Secret for Proposal Signing
HMAC_SECRET_KEY=change-me

# Voice Channel (Twilio + ElevenLabs + Deepgram) - required for the recovery call demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
# Who the agent sounds like. THESE TWO MUST BE THE SAME PERSON.
#
# A call uses both: the opening turn plays the ElevenLabs line and then the
# Twilio keypad note back to back, and any turn that overruns the 2s budget
# falls back to Twilio mid-call. Mismatch them and the caller changes voice
# in the middle of a sentence.
#
# Leave ELEVENLABS_VOICE_ID empty to turn ElevenLabs off and render every
# line with TWILIO_VOICE_NAME - one guaranteed-consistent voice, no 2s
# budget, a little less expressive.
ELEVENLABS_VOICE_ID=
# Male, Indian English, neural. Polly has no male en-IN neural voice, so
# this is a Google voice - Twilio exposes both.
TWILIO_VOICE_NAME=Google.en-IN-Neural2-B
# Twilio speech recognition takes ONE language; <Gather> has no bilingual
# mode. en-IN transcribes code-switched Hinglish far better than hi-IN
# transcribes English, and a mis-transcription feeds the confidence gate
# that blocks the money tools - so this setting affects recovery, not just
# the transcript.
VOICE_GATHER_LANGUAGE=en-IN
# How the agent SPEAKS: english (default) or hinglish.
#
# Separate from VOICE_GATHER_LANGUAGE because output and input have opposite
# costs. Speaking Hinglish is free. LISTENING for it is not - <Gather> takes
# one language, and a mis-transcription feeds the confidence gate that blocks
# the money tools, so it costs recoveries rather than just transcript quality.
#
# Hinglish is written in Roman letters and keeps numbers in English, because
# the line is read aloud by an Indian-English voice: Devanagari comes out as
# nonsense, and a mispronounced rupee amount is the worst error this call can
# make.
AGENT_LANGUAGE=english
DEEPGRAM_API_KEY=
NGROK_URL=

# Email Channel (Resend) - required for the recovery email demo
RESEND_API_KEY=
EMAIL_FROM=
CUSTOMER_EMAIL=
CUSTOMER_PHONE=

# Database (optional - falls back to local SQLite if unset)
#
# Use the Supabase SUPAVISOR POOLER host, not the direct one:
#   pooler   aws-<n>-<region>.pooler.supabase.com:6543   <- this
#   direct   db.<project-ref>.supabase.co:5432           <- not this
#
# The direct endpoint makes every new connection do a full Postgres startup
# and TLS handshake against the primary. That is measured, not theoretical:
# a single-row indexed SELECT timed at 2365ms from Railway, and a voice turn
# makes about a dozen round trips inside Twilio's 15-second window. See
# FINDINGS #17.
#
# And deploy the backend in the SAME REGION as this database. Railway in
# Amsterdam talking to Supabase in Seoul cost ~250ms of pure geography on
# every call, which was the whole latency problem.
DATABASE_URL=

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app
# Auth & encryption (see app/core/config.py for how to generate real values)
JWT_SECRET_KEY=
FERNET_KEY=

# Sign in with Google (optional). BOTH belong to the SERVER - the client
# secret is exactly what its name says, and these previously sat in
# frontend/.env.local for a feature that had no backend route at all.
#
# Leave empty and the dashboard simply does not offer the button, rather
# than offering one that fails. Register this exact callback URL in the
# Google console, matching NGROK_URL above:
#   https://<your-kinato-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the browser is sent after Google is done - the DASHBOARD's origin,
# which is not necessarily this server's.
FRONTEND_URL=http://localhost:3000

# --- Guest sign-in (optional) -------------------------------------------
# Lets a reviewer open the dashboard without creating an account. Point it
# at an existing merchant; the browser only ever calls /api/auth/guest and
# never sees these values.
#
# Leave both empty and the button does not appear at all. Never commit a
# real password here - this file is in git.
GUEST_DEMO_EMAIL=
GUEST_DEMO_PASSWORD=
