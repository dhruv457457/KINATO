# LLM Provider Configuration (OpenRouter by default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-exp:free

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Security & HMAC Secret for Proposal Signing
HMAC_SECRET_KEY=change-me

# Voice Channel (Twilio + ElevenLabs + Deepgram) - required for the recovery call demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
NGROK_URL=

# Email Channel (Resend) - required for the recovery email demo
RESEND_API_KEY=
EMAIL_FROM=
CUSTOMER_EMAIL=
CUSTOMER_PHONE=

# Database (optional - falls back to local SQLite if unset)
DATABASE_URL=

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app
# Auth & encryption (see app/core/config.py for how to generate real values)
JWT_SECRET_KEY=
FERNET_KEY=
