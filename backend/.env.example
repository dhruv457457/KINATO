# LLM Provider Configuration (OpenRouter by default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
# A voice turn spends two round trips here and has to answer inside
# Twilio's 15 seconds, so the model's SPEED matters as much as its quality.
# Prefer a slug OpenRouter serves from a fast provider (Groq, Cerebras).
# Whatever you change this to, validate it with scripts/run_recovery_batch.py
# and read the RECOVERED counts, not rule_breaks - see FINDINGS #14 for what
# a bad swap looks like (recoveries 6 -> 0 while check_offer fired MORE).
LLM_MODEL=openai/gpt-4o-mini

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Security & HMAC Secret for Proposal Signing
HMAC_SECRET_KEY=change-me

# Voice Channel (Twilio + ElevenLabs + Deepgram) - required for the recovery call demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
NGROK_URL=

# Email Channel (Resend) - required for the recovery email demo
RESEND_API_KEY=
EMAIL_FROM=
CUSTOMER_EMAIL=
CUSTOMER_PHONE=

# Database (optional - falls back to local SQLite if unset)
#
# Use the Supabase SUPAVISOR POOLER host, not the direct one:
#   pooler   aws-<n>-<region>.pooler.supabase.com:6543   <- this
#   direct   db.<project-ref>.supabase.co:5432           <- not this
#
# The direct endpoint makes every new connection do a full Postgres startup
# and TLS handshake against the primary. That is measured, not theoretical:
# a single-row indexed SELECT timed at 2365ms from Railway, and a voice turn
# makes about a dozen round trips inside Twilio's 15-second window. See
# FINDINGS #17.
#
# And deploy the backend in the SAME REGION as this database. Railway in
# Amsterdam talking to Supabase in Seoul cost ~250ms of pure geography on
# every call, which was the whole latency problem.
DATABASE_URL=

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app
# Auth & encryption (see app/core/config.py for how to generate real values)
JWT_SECRET_KEY=
FERNET_KEY=
